{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "strict": true,
    "target": "ES2023",
    "types": [
      "node"
    ],
    "verbatimModuleSyntax": true
  },
  "include": [
    "build.ts",
    "src/**/*.ts",
    "test/**/*.ts"
  ]
}
